# .ebextensions/django.config
# Platform: Python on Amazon Linux 2023

# This section installs system-level packages.
packages:
  dnf:
    # Installs PostgreSQL development libraries needed to build psycopg2.
    postgresql15-devel: []

# This section configures the application and proxy server.
option_settings:
  # 1. Sets the Django settings module for your application.
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "CEBackend.settings"

  # 2. Configures the Nginx proxy server to serve static files.
  # This tells Nginx that any request starting with /static/ should be
  # served from the 'static/' directory in your project's root.
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static/: static/