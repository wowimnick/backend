# .ebextensions/django.config
# Platform: Python on Amazon Linux 2023

# Installs system-level packages needed to build Python dependencies.
packages:
  dnf:
    postgresql15-devel: []

# Configures the application and platform settings.
option_settings:
  # Sets the Django settings module for your application.
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "CEBackend.settings"

  # Tells EBS where to find your static files and where to upload them in S3.
  # This is the recommended way to handle collectstatic.
  aws:elasticbeanstalk:container:python:staticfiles:
    /static/: "static/"