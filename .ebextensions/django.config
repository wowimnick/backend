# .ebextensions/django.config
# Platform: Python on Amazon Linux 2023

# This section installs system-level packages.
packages:
  dnf:
    # Installs PostgreSQL development libraries needed to build psycopg2.
    postgresql15-devel: []

# This section configures the application server.
option_settings:
  aws:elasticbeanstalk:application:environment:
    # Points to your main settings file.
    DJANGO_SETTINGS_MODULE: "CEBackend.settings"
  aws:elasticbeanstalk:container:python:
    # This is overridden by your Procfile, but it's good practice to set it.
    WSGIPath: CEBackend.asgi:application