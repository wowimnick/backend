# .ebextensions/django.config

# This section sets environment variables for the entire environment, 
# including the shell where container_commands are run.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "CEBackend.settings"

# This tells EBS to install the correct PostgreSQL client developer libraries
# for the Amazon Linux 2023 platform.
packages:
  dnf: # Use 'dnf' for Amazon Linux 2023
    postgresql15-devel: []

# These commands are run on the server during deployment.
# They will now inherit the DJANGO_SETTINGS_MODULE from option_settings.
container_commands:
  01_migrate:
    # This command runs your database migrations.
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    # This command collects all your static files into one directory.
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true