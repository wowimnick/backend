# .ebextensions/django.config

# This tells EBS to install the correct PostgreSQL client developer libraries
# for the Amazon Linux 2023 platform.
packages:
  dnf: # Use 'dnf' instead of 'yum' for Amazon Linux 2023
    postgresql15-devel: []

container_commands:
  01_migrate:
    # This command first loads the environment variables, then runs migrate with the correct python.
    command: "source /opt/elasticbeanstalk/deployment/env && /var/app/venv/staging/bin/python manage.py migrate --noinput"
    leader_only: true