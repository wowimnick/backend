# Platform: Python on Amazon Linux 2023
# This file installs system-level packages and runs database migrations.

option_settings:
  # This setting ensures container_commands run from the correct directory
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: CEBackend.settings

container_commands:
  # Command 01: Install PostgreSQL development libraries needed to build the 'psycopg2' package.
  # Use 'dnf' for Amazon Linux 2023.
  01_install_postgres_dev:
    command: "sudo dnf install -y postgresql-devel"
    # test: "rpm -q postgresql-devel" # Optional: add a test to not run it if already installed.

  # Command 02: Run database migrations.
  # IMPORTANT: leader_only ensures this only runs on one instance at a time during deployments.
  # NOTICE: No 'source' command is needed. The DB credentials are in the environment.
  02_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
    
  # Command 03: Collect static files.
  # This should also be run on the leader only to avoid multiple instances writing to S3.
  03_collectstatic:
    command: "python manage.py collectstatic --noinput"
    leader_only: true

